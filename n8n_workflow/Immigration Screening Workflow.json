{
  "name": "Immigration Screening Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "screen-passenger",
        "responseMode": "responseNode"
      },
      "type": "n8n-nodes-base.webhook",
      "position": [-784, 112],
      "name": "Webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/screen",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"passport_number\": \"{{ $json.passport_number }}\", \"face_image\": \"{{ $json.face_image }}\" }"
      },
      "type": "n8n-nodes-base.httpRequest",
      "position": [-576, 112],
      "name": "Screening API"
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{ $json.result.risk_level }}",
              "rightValue": "HIGH",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        }
      },
      "type": "n8n-nodes-base.if",
      "position": [-368, 112],
      "name": "Check Risk Level"
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={ \"passport_number\": \"{{ $json.result.passport_number }}\", \"full_name\": \"{{ $json.result.full_name }}\", \"risk_score\": \"{{ $json.result.risk_score }}\", \"risk_level\": \"HIGH\", \"final_lane\": \"SECONDARY_SCREENING\", \"final_decision\": \"Secondary Screening Required\", \"verification_status\": \"Manual Review Required\" }"
      },
      "type": "n8n-nodes-base.set",
      "position": [0, 0],
      "name": "Flagged Passenger"
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={ \"passport_number\": \"{{ $json.result.passport_number }}\", \"full_name\": \"{{ $json.result.full_name }}\", \"risk_score\": \"{{ $json.result.risk_score }}\", \"risk_level\": \"{{ $json.result.risk_level }}\", \"final_lane\": \"{{ $json.result.assigned_lane }}\", \"final_decision\": \"Cleared\", \"verification_status\": \"Verified Successfully\" }"
      },
      "type": "n8n-nodes-base.set",
      "position": [0, 256],
      "name": "Normal Passenger"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ { \"message\": \"Immigration Screening Completed\", \"result\": $json } }"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [272, 96],
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Screening API", "type": "main" }]] },
    "Screening API": { "main": [[{ "node": "Check Risk Level", "type": "main" }]] },
    "Check Risk Level": {
      "main": [
        [{ "node": "Flagged Passenger", "type": "main" }],
        [{ "node": "Normal Passenger", "type": "main" }]
      ]
    },
    "Flagged Passenger": { "main": [[{ "node": "Respond to Webhook", "type": "main" }]] },
    "Normal Passenger": { "main": [[{ "node": "Respond to Webhook", "type": "main" }]] }
  },
  "active": true
}